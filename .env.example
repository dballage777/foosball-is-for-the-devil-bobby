# =====================================================================
# Bible Study Platform — environment variables
# Copy to `.env.local` and fill in real values. NEVER commit .env.local.
# All values below are safe placeholders only.
# =====================================================================

# ---- Supabase (Auth + Postgres + Row Level Security) ----
# Public values (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only. NEVER expose to the client. Used only in trusted server code
# (migrations, admin scripts). Bypasses RLS — handle with extreme care.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Bible content provider (see docs/bible-licensing.md) ----
# Provider abstraction lets you swap implementations. Values:
#   ""            -> AUTO: use API.Bible if BIBLE_API_KEY is set, else public domain
#   "apibible"    -> API.Bible (scripture.api.bible, American Bible Society)
#   "public_domain" -> World English Bible (WEB) via bible-api.com (no key)
# Default translation via API.Bible is the Berean Standard Bible (BSB): a modern,
# freely-licensed, NIV-style translation with NO license restriction. If the
# provider is unavailable or unconfigured, the reader falls back to WEB.
BIBLE_PROVIDER=""

# API.Bible key (free at https://scripture.api.bible). Required for "apibible".
# A key alone does NOT grant NIV rights — the NIV is licensed separately by
# Biblica and must be enabled for your key. BSB needs no such license.
BIBLE_API_KEY=""
# Which edition to request. By default the provider resolves this abbreviation
# from the API.Bible catalog (no need to know the raw id):
BIBLE_VERSION_ABBR="BSB"
# Optional: pin an exact API.Bible bible id (skips the abbreviation lookup).
# Use this for a licensed NIV edition id, or to pin a specific BSB id.
BIBLE_DEFAULT_VERSION_ID=""

# ---- Audio provider (Listener's Commentary — see docs/audio-licensing.md) ----
# Audio is linked/embedded from the official source, never re-hosted.
# No secret required for official links; document any embed keys here if a
# provider later requires them.

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
